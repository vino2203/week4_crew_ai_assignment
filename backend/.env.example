# --- LLM (used by CrewAI agents) ---
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL_NAME=gpt-4o-mini

# Avoids CrewAI's interactive "view execution traces?" prompt on first run,
# which would hang a non-interactive process (e.g. the Streamlit server).
CREWAI_TRACING_ENABLED=false

# --- SerpAPI (Agent 2: Web Search Specialist) ---
SERPAPI_API_KEY=your-serpapi-key-here

# --- Neo4j (Knowledge Graph + Long-Term Memory) ---
# If a Neo4j instance is not reachable at this URI, the system automatically
# falls back to an in-memory mock graph store so the app still runs.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme-neo4j

# --- FAISS store ---
# FAISS_INDEX_DIR=  # defaults to backend/data/faiss_index next to this file
EMBEDDING_MODEL=all-MiniLM-L6-v2
